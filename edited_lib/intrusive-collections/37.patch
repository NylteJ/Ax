From 1976760c15cceb75d33ba66d466bb2b71dd1b12c Mon Sep 17 00:00:00 2001
From: amari <arobinson.5000@yahoo.com>
Date: Sun, 26 Apr 2020 01:36:58 -0700
Subject: [PATCH 10/11] Add workaround for Rust 1.36 integer constant type
 coercion bug

---
 src/hash_table/hash_table.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/hash_table/hash_table.rs b/src/hash_table/hash_table.rs
index 5ea24a7..1f4a14a 100644
--- a/src/hash_table/hash_table.rs
+++ b/src/hash_table/hash_table.rs
@@ -2779,7 +2779,7 @@ mod tests {
 
         for obj in &m {
             assert_eq!(obj.value(), obj.key() * 2);
-            observed |= 1 << obj.key();
+            observed |= 1_u32 << obj.key();
         }
 
         assert_eq!(observed, 0xFFFF_FFFF);

