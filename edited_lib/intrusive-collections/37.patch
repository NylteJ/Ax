+    A::KeyOps: for<'b> KeyOps<'b, <A::PointerOps as PointerOps>::Value>,
+{
+    #[inline]
+    pub fn from_key<'b, Q: ?Sized>(self, k: &Q) -> RawEntryMut<'a, A, B>
