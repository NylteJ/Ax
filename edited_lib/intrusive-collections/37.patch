+        <A::KeyOps as KeyOps<'b, <A::PointerOps as PointerOps>::Value>>::Key: Borrow<Q>,
+        A::HashOps: HashOps<Q>,
+        Q: Eq,
+        <A::PointerOps as PointerOps>::Value: 'b,
