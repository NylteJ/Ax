ENTRY(_start)

SECTIONS
{
    . = BASE_ADDRESS;
    skernel = .;

    stext = .;
    .text : AT(. - ADDRESS_OFFSET) {
        *(.text.entry)
        suaccess_copy = .;
        *(.text.uaccess.copy)
        euaccess_copy = .;
        suaccess_strcpy = .;
        *(.text.uaccess.strcpy)
        euaccess_strcpy = .;
        suaccess_memset = .;
        *(.text.uaccess.memset)
        euaccess_memset = .;
        *(.text .text.*)
    }

    . = ALIGN(4K);
    etext = .;
    srodata = .;
    .rodata : AT(. - ADDRESS_OFFSET) {
        *(.rodata .rodata.*)
        *(.srodata .srodata.*)
    }

    . = ALIGN(4K);
    erodata = .;
    sdata = .;
    .data : AT(. - ADDRESS_OFFSET) {
        *(.data .data.*)
        *(.sdata .sdata.*)
    }

    . = ALIGN(4K);
    edata = .;
    .bss : AT(. - ADDRESS_OFFSET) {
        *(.bss.stack)
        *(.bss.kheap)
        sbss = .;
        *(.bss .bss.*)
        *(.sbss .sbss.*)
    }

    . = ALIGN(4K);
    ebss = .;
    __debug_data_start = .;
    .debug_infos : AT(. - ADDRESS_OFFSET) {
        KEEP(*(.debug_infos))
    }

    . = ALIGN(4K);
    __debug_data_end = .;
    ekernel = .;
}
